# --- DATABASE CONNECTION ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=skywalk
DB_SSL=false

# --- JWT CONFIG ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h

# --- RAPIDAPI (Cost of Living) ---
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=cost-of-living-and-prices.p.rapidapi.com

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@skywalk.com

# --- APP ---
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# --- OPENAI (Content Moderation - free) ---
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# --- GOV-LINKS IA (recherche + ranking LLM) ---
# Provider de recherche : 'searxng' (docker local, SEARXNG_BASE_URL) ou 'tavily' (API hébergée).
# En prod (Heroku) comme en local sans docker : tavily. Clé gratuite sur app.tavily.com
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key
# SEARXNG_BASE_URL=http://localhost:8888

# LLM OpenAI-compatible. Local : Ollama (http://localhost:11434/v1, clé 'ollama').
# Prod : Groq (console.groq.com) ou tout endpoint /v1 compatible.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_groq_api_key

# Lecture des pages : 'jina' (r.jina.ai, recommandé en prod) ou vide (lecteur local).
PAGE_READER=jina
